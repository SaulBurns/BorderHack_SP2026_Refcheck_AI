# RefCheck AI backend environment variables

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Which AI provider answers the four-agent pipeline. Switching providers is a
# single env change; no code changes. Supported values: mock | anthropic | gemini | router.
# An unsupported value fails loudly at request time (it does not silently degrade).
#   mock      - demo-safe, no paid keys, canned output
#   anthropic - real four-agent Claude pipeline (needs ANTHROPIC_API_KEY)
#   gemini    - real four-agent pipeline via Google Gemini (needs GEMINI_API_KEY)
#   router    - per-agent providers AND models (see the router section below)
AI_PROVIDER=mock

# Perception detector feature flag (default: claude_vision).
#   claude_vision - current behavior (Claude Vision perception)
#   yolov8        - YOLO object detection (requires ultralytics)
#   hybrid        - Claude perception + YOLO detections
# DETECTOR=claude_vision

# YOLO detector configuration (Sprint 18A; used when DETECTOR=yolov8 or hybrid).
# Default weights upgraded to the latest stable Ultralytics flagship, YOLO26-nano.
# YOLO_MODEL=yolo26n.pt        # e.g. yolo11n.pt, yolov8n.pt, yolo26s.pt
# YOLO_CONFIDENCE=0.25         # detection confidence threshold
# YOLO_TRACKER=bytetrack.yaml  # Ultralytics tracker config
# YOLO_TRACKING=1              # 1 = persistent track_ids across frames; 0 = detection-only

# Anthropic option:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-5        # optional override; default: claude-sonnet-4-5
# ANTHROPIC_API_KEY=your_anthropic_key

# Gemini option (the google-genai SDK ships in the production image, Sprint 17C;
# for a local venv: pip install google-genai):
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash     # optional override; default: gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_key

# Graceful failover (Sprint 17C). If the selected provider fails a call (auth /
# bad request / missing SDK, or transient retries exhausted), the pipeline retries
# the turn once on this provider before degrading to the offline mock. Unset =
# no failover. Great for a Gemini primary: PROVIDER_FALLBACK=anthropic.
# PROVIDER_FALLBACK=anthropic

# Router option — per-agent providers AND models (Sprint 17A + 17B).
# With AI_PROVIDER=router, each pipeline stage picks its own provider and model.
# Set the keys for whichever providers you route to. Any var left unset falls back:
# a provider -> ROUTER_DEFAULT_PROVIDER (default: anthropic); a model -> that
# provider's own default (AI_MODEL / GEMINI_MODEL or built-in). So an empty router
# config behaves exactly like AI_PROVIDER=anthropic.
# Example: cheap/fast vision for perception, strong reasoning for adjudication.
# AI_PROVIDER=router
# ROUTER_DEFAULT_PROVIDER=anthropic
# PERCEPTION_PROVIDER=gemini
# PERCEPTION_MODEL=gemini-2.5-flash
# ADJUDICATOR_PROVIDER=anthropic
# ADJUDICATOR_MODEL=claude-sonnet-4-5
# (Legacy Sprint 17A provider vars still work as fallbacks for the new names above:
#  ROUTER_PERCEPTION_PROVIDER, ROUTER_ADJUDICATION_PROVIDER.)

# Optional Supabase persistence.
# Use the service role key only on the backend/Render, never in Vercel.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_CLIPS_BUCKET=clips
# SUPABASE_VERDICTS_TABLE=verdicts
